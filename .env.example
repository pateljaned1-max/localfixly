# LocalFix Environment Variables Example

# Server Settings
PORT=5000
FLASK_ENV=development
DEBUG=True

# Security Secrets (Generate a strong random 256-bit key for production)
JWT_SECRET=localfix-super-secret-jwt-key-2026-v1-prod-change-me

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Database Settings
LOCALFIX_DB_PATH=database/localfix.db

# Seed Data (Set to False in production)
SEED_DEMO_DATA=True
